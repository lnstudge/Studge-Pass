{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lnstudge/Studge-Pass/tools/preview/status.schema.json",
  "title": "Studge Pass preview status",
  "description": "The data behind the local dev-preview dashboard (docs/preview/status.json). Screenshot paths are relative to docs/ so the page can serve them from its static root.",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "steps", "checks", "commits", "screenshots", "try_it", "risks", "links"],
  "properties": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "branch", "pr_url"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "pattern": "^phase-[0-9a-z-]+$" },
        "pr_url": { "type": ["string", "null"], "pattern": "^https://" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "title", "state", "summary", "commit_sha"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "state": { "enum": ["done", "doing", "next"] },
          "summary": { "type": "string" },
          "commit_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fmt", "clippy", "tests", "deny", "updated_at"],
      "properties": {
        "fmt": { "enum": ["pass", "fail", null] },
        "clippy": { "enum": ["pass", "fail", null] },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "failed", "ignored"],
          "properties": {
            "passed": { "type": ["integer", "null"], "minimum": 0 },
            "failed": { "type": ["integer", "null"], "minimum": 0 },
            "ignored": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "deny": { "enum": ["pass", "fail", null] },
        "updated_at": { "type": "string", "minLength": 1 }
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "message", "url"],
        "properties": {
          "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "message": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "caption"],
        "properties": {
          "path": { "type": "string", "pattern": "^screenshots/[A-Za-z0-9._/-]+$" },
          "caption": { "type": "string" }
        }
      }
    },
    "try_it": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "command_or_url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "command_or_url": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "severity", "status"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "status": { "enum": ["open", "fixed", "accepted"] }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
